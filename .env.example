# Copy to .env and fill in. Never commit .env (it is gitignored).
# The agent reads OPENAI_API_KEY, falling back to OPENAI_KEY.
OPENAI_API_KEY=
# OPENAI_KEY=   # alternative name; either works
OPENAI_MODEL=gpt-4o-mini

# Lucas County ArcGIS REST FeatureServer layers (public endpoints).
ARCGIS_SEPTIC_URL=https://lcenggis.co.lucas.oh.us/gisengserver/rest/services/LCHD_SEPTIC/SEPTIC_SYSTEM_VIEW/FeatureServer/0
ARCGIS_FLOODPLAIN_0_URL=https://lcenggis.co.lucas.oh.us/gisengserver/rest/services/FLOODPLAIN/FLOODPLAIN_VIEW/FeatureServer/0
ARCGIS_FLOODPLAIN_4_URL=https://lcenggis.co.lucas.oh.us/gisengserver/rest/services/FLOODPLAIN/FLOODPLAIN_VIEW/FeatureServer/4
# Live servers are currently unreachable from this environment (timeouts), so
# mock fixtures are served. Set to "false" to hit the live URLs (no code change).
ARCGIS_USE_MOCK=true

# NCWQR knowledge-source pages (live and ingested at citation level).
NCWQR_PUBLICATIONS_URL=https://ncwqr.org/publications/lab-publications/
NCWQR_DERIVED_WORKS_URL=https://ncwqr.org/publications/derived-works/

# Local data (defaults work: first data/*.xlsx is auto-discovered).
MAUMEE_XLSX_PATH=
KNOWLEDGE_INDEX_PATH=knowledge/ncwqr_index.json
