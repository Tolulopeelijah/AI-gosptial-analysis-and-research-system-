# Copy to .env and fill in. Never commit .env (it is gitignored).
# The agent reads OPENAI_API_KEY, falling back to OPENAI_KEY.
OPENAI_API_KEY=
# OPENAI_KEY=   # alternative name; either works
OPENAI_MODEL=gpt-4o-mini

# Lucas County ArcGIS REST layers (public endpoints). NOTE: the
# FeatureServer paths return HTTP-200 code-500 on every layer — use the
# MapServer paths below, verified live 2026-09-29 (septic=15,919 polys,
# flood hazard=3,369, county flood=14; all esriGeometryPolygon, max 2000).
ARCGIS_SEPTIC_URL=https://lcenggis.co.lucas.oh.us/gisengserver/rest/services/LCHD_SEPTIC/SEPTIC_SYSTEM_VIEW/MapServer/0
ARCGIS_FLOODPLAIN_0_URL=https://lcenggis.co.lucas.oh.us/gisengserver/rest/services/FLOODPLAIN/FLOODPLAIN_VIEW/MapServer/6
ARCGIS_FLOODPLAIN_4_URL=https://lcenggis.co.lucas.oh.us/gisengserver/rest/services/FLOODPLAIN/FLOODPLAIN_VIEW/MapServer/7
# Live county servers time out from some networks; mock fixtures are served
# while true. Set to "false" to hit the live URLs above (no code change).
ARCGIS_USE_MOCK=false

# NCWQR knowledge-source pages (live and ingested at citation level).
NCWQR_PUBLICATIONS_URL=https://ncwqr.org/publications/lab-publications/
NCWQR_DERIVED_WORKS_URL=https://ncwqr.org/publications/derived-works/

# Local data (defaults work: first data/*.xlsx is auto-discovered).
MAUMEE_XLSX_PATH=
KNOWLEDGE_INDEX_PATH=knowledge/ncwqr_index.json
